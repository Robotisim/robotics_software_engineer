<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam</name>
  <version>0.0.0</version>
  <description>SLAM launch and RViz configurations for Jazzy/Gazebo Sim examples.</description>
  <maintainer email="noshluk2@gmail.com">luqman</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>custom_robots</depend>
  <depend>mapping</depend>
  <depend>nav2_map_server</depend>
  <depend>robot_sensing</depend>
  <depend>rviz2</depend>
  <depend>slam_toolbox</depend>

  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
